# DigiSociety College Edition — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.

# Server
PORT=8080

# PostgreSQL — local dev example
DATABASE_URL=jdbc:postgresql://localhost:5432/digisociety_college
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_MS=28800000

# Admin seed user (created on first boot)
ADMIN_EMAIL=admin@college.digisociety.in
ADMIN_PASSWORD=changeme123

# Spring JPA
# "update" for dev, "validate" for prod
JPA_DDL_AUTO=update

# CORS — your college frontend URL
FRONTEND_URL=http://localhost:5173

# ── AWS S3 — File Storage ─────────────────────────────────────────────────────
# Create an IAM user with AmazonS3FullAccess (or a scoped policy),
# then paste the access key pair below.
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your_bucket_name
